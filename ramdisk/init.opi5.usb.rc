on boot
    # This board uses every external USB connector in host mode.  Keep adbd on
    # authenticated Ethernet/TCP in every build variant and do not create
    # FunctionFS endpoints: their presence makes adbd continuously retry the
    # unavailable gadget UDC.  User builds retain ro.adb.secure=1 and therefore
    # accept only a host authorized by the packaged public key.
    setprop service.adb.tcp.port 5555
    setprop sys.usb.configfs 2
    setprop sys.usb.config none
    setprop sys.usb.state none
    start adbd

# Product defaults for userdebug may publish "adb" after the boot action.  Keep
# that default from re-enabling FunctionFS while leaving the TCP daemon alive.
on property:sys.usb.config=adb
    setprop sys.usb.config none
    setprop sys.usb.state none
