gpu_access(mediacodec)
get_prop(mediacodec, vendor_ffmpeg_config_prop)
get_prop(mediacodec, vendor_v4l2_config_prop)

# FFmpeg's V4L2-request backend discovers media devices through libudev's
# /sys/dev/char enumeration. Limit enumeration to that namespace.
allow mediacodec sysfs_char_devices:dir r_dir_perms;
allow mediacodec sysfs_char_devices:lnk_file r_file_perms;
allow mediacodec sysfs_video_codec:dir r_dir_perms;
allow mediacodec sysfs_video_codec:file r_file_perms;
allow mediacodec sysfs_video_codec:lnk_file r_file_perms;
