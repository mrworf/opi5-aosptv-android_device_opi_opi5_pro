get_prop(hal_audio_default, vendor_audio_config_prop)
get_prop(hal_audio_default, a2dp_manual_sync_prop)

# The AIDL audio HAL receives Fast Message Queue event-flag descriptors created
# by the framework as anonymous tmpfs files.  The kernel reports these as
# memfd:MessageQueue, but they retain the generic tmpfs label rather than a
# domain-specific memfd_file label.  Updating the event word requires write
# access; no path lookup, creation, execution, or general read access is needed.
allow hal_audio_default tmpfs:file { map write };
