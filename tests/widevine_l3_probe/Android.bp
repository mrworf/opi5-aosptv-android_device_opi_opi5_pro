java_binary {
    name: "WidevineL3Probe",
    srcs: ["src/**/*.java"],
    main_class: "org.orangepi.widevineprobe.Main",
    sdk_version: "system_current",
    dex_preopt: {
        enabled: false,
    },
}

android_test {
    name: "WidevineL3ProbeTests",
    srcs: [
        "src/**/*.java",
        "testsrc/**/*.java",
    ],
    manifest: "AndroidManifest.xml",
    sdk_version: "system_current",
    libs: ["android.test.runner.stubs.system"],
    static_libs: [
        "androidx.test.ext.junit",
        "androidx.test.rules",
    ],
    test_suites: ["general-tests"],
}
